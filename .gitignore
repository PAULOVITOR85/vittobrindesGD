# ============================================
# VITTO GD - .gitignore
# ============================================

# ---------- Imagens ----------
# Todas as imagens são rastreadas (necessárias para o site funcionar)
# NÃO adicionar img/*.jpg, img/*.png, img/*.webp ao gitignore

# ---------- Backups locais ----------
backups/

# ---------- Sistema ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---------- Logs ----------
*.log
npm-debug.log*

# ---------- Temporários ----------
tmp/
temp/
.cache/
