# ============================================
# VITTO GD - .gitignore
# ============================================

# ---------- Imagens (manter leve no Git) ----------
# Imagens de produto (grandes, podem ser re-baixadas)
img/*.jpg
img/*.png
img/*.webp

# Manter apenas SVGs e ícones PWA
!img/*.svg
!img/icon-*.png
!img/icon-maskable-*.png

# ---------- Backups locais ----------
backups/

# ---------- Sistema ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---------- Logs ----------
*.log
npm-debug.log*

# ---------- Temporários ----------
tmp/
temp/
.cache/
